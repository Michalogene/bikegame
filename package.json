{
  "name": "afterdark-county",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A modular isometric browser survival game vertical slice.",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "predev": "npm run vendor",
    "dev": "node scripts/serve.mjs",
    "prebuild": "npm run vendor",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/browser-smoke.mjs",
    "reliability": "node scripts/reliability-smoke.mjs"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
